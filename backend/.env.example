# ==============================================================================
# RakshaSetu - Real-Time Multi-Hazard Risk & Evacuation Infrastructure
# ==============================================================================

ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 1. REAL-TIME OPEN-SOURCE DATA PIPELINES (ZERO API KEY REQUIRED)
# RakshaSetu connects out-of-the-box to the following public, open APIs:
#
# • Open-Meteo Weather API (Open Data):
#   Endpoint: https://api.open-meteo.com/v1/forecast
#   Provides real-time precipitation (mm), temperature (°C), and wind speed (km/h).
#   Used directly for dynamic flood, cyclone, and extreme weather hazard calculation.
#
# • USGS Real-Time Earthquake Hazards API (Open Data):
#   Endpoint: https://earthquake.usgs.gov/fdsnws/event/1/query
#   Provides real-time seismic event hypocenters, magnitudes, and timestamps.
#   Used dynamically to compute nearest earthquake distance (km) and seismic hazard score.
#
# • NDMA SACHET - Disaster Early Warning Common Alerting Protocol (Open Data):
#   Endpoint: https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails
#   Provides official government disaster bulletins across Indian states and districts.
#
# • GDACS (Global Disaster Alert and Coordination System) (Open Data):
#   Endpoint: https://www.gdacs.org/xml/rss.xml
#   Provides international and regional disaster alerts (floods, cyclones, earthquakes).
#
# • OSRM (Open Source Routing Machine) (Open Source):
#   Endpoint: https://router.project-osrm.org/route/v1/driving/
#   Provides live road-network geometry, turn-by-turn road instructions, and driving ETA.
#
# • Google News RSS India Disaster Bulletins (Open Source):
#   Endpoint: https://news.google.com/rss/search
#   Provides real-time localized news coverage for active disaster response.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 2. OPTIONAL COMPLEMENTARY API KEYS
# ------------------------------------------------------------------------------

# NASA FIRMS (Fire Information for Resource Management System):
# Free key available at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Provides satellite active fire hotspot detections (VIIRS / MODIS).
FIRMS_API_KEY=

# OpenWeatherMap (Optional alternative weather provider):
# Free key available at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# AI Assistant Providers (Choose 'openai', 'gemini', or 'anthropic'):
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Mapbox vector tiles (OSM Leaflet tiles used by default)
MAPBOX_TOKEN=

# Optional: Production PostgreSQL + PostGIS database connection string
DATABASE_URL=

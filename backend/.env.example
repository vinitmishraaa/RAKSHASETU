# ---------------------------------------------------------------------------
# RakshaSetu backend environment variables
# The prototype runs with ZERO keys set - it uses synthetic data and free
# OpenStreetMap tiles. Fill in the ones below only if you want to switch on
# the matching real integration.
# ---------------------------------------------------------------------------

ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: real Postgres+PostGIS instance. Leave unset to keep using the
# in-memory synthetic dataset in app/data/synthetic.py.
DATABASE_URL=

# Optional: enables live rainfall/weather ingestion instead of the
# synthetic rainfall trend. Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Optional: enables full natural-language answers in the AI Assistant tab.
# Without this the assistant still works, using a templated summary of the
# same underlying risk/relocation data. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: swap the free OSM tiles for Mapbox vector tiles.
# Get a free-tier token at https://www.mapbox.com/
MAPBOX_TOKEN=

# Optional, not wired into the prototype UI yet - placeholders for the
# future Alert & Escalation Engine (SMS/WhatsApp notifications).
SMS_API_KEY=
SMS_API_SECRET=
